<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>VspcAutotaskPlugin</id>
        <version>1.5.6</version>
        <description>Autotask PSA integration for Veeam Service Provider Console — company mapping, billing synchronization to Autotask recurring-service contracts, and automated service tickets from VSPC alarms.</description>
        <authors>Veeam Community Integrations</authors>
        <icon>content\any\any\ui-content\favicon.png</icon>
    </metadata>
    <files>
        <file src="content\**\*.*" target="content\" />
    </files>
</package>
